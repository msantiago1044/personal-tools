{
  "expo": {
    "name": "Personal Tools",
    "slug": "personal-tools",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "personaltools",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#030712"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msantiago1044.personaltools"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#030712"
      },
      "package": "com.msantiago1044.personaltools"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
